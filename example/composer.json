{
  "name": "fixwire/laravel-example",
  "description": "A Laravel app reporting to Fixwire, run against a fake ingest by its test",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "fixwire/fixwire": "*@dev",
    "fixwire/laravel": "*@dev",
    "laravel/framework": "^11.0 || ^12.0 || ^13.0"
  },
  "require-dev": {
    "laravel/octane": "^2.20",
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/fixwire/fixwire-php"
    },
    {
      "type": "path",
      "url": "..",
      "options": {
        "versions": {
          "fixwire/laravel": "0.1.x-dev"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "lock": false,
    "sort-packages": true
  }
}
